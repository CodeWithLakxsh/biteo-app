# ============================================================
# Biteo App — .gitignore
# ============================================================

# ---- Dart / Flutter -----------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
coverage/
*.g.dart
*.freezed.dart

# ---- Generated plugin build dirs (desktop) ------------------
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/
/windows/flutter/ephemeral/
/ephemeral/

# ---- IntelliJ / Android Studio ------------------------------
.idea/
*.iml
*.ipr
*.iws
android/.idea/
android/.kotlin/
android/local.properties
android/key.properties

# ---- Visual Studio Code -------------------------------------
.vscode/

# ---- macOS --------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride

# ---- Android build / signing --------------------------------
*.apk
*.aab
*.jks
*.keystore
android/gradle-wrapper.jar
*.hprof

# ---- Node.js / npm (root has no project; functions & support-ai do) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Environment & secrets ----------------------------------
# Local environment files. Never commit real credentials.
# .env.example IS committed as the documented template.
.env
.env.*
!.env.example
!.env.example.*

# ---- Firebase ------------------------------------------------
.firebase/
firebase-debug.log*
firebase-debug.*.log*
# .firebaserc is committed (shared project alias)
!firebase.json

# Real Android client config (android/app/google-services.json) is supplied
# locally / via CI secrets, NOT committed. The template is committed.
android/app/google-services.json
!android/app/google-services.json.example

# ---- Android Attestation keybox (CONTAINS ECDSA PRIVATE KEY) ---
# linux/yk50.xml holds an Android Attestation keybox with a private key
# and certificate chain. It must NEVER be committed.
linux/yk50.xml
*.keybox

# ---- Logs / runtime -----------------------------------------
*.log
logs/
pids/
*.pid
*.pid.lock
*.seed
.nyc_output/
coverage/
.eslintcache
