# ============================================================
# Biteo App — Environment Configuration Template
# ============================================================
# Copy this file to a local `.env` (which is git-ignored) and fill in
# values for local development. NEVER commit real credentials.
#
# Security notes:
# - The Flutter app loads `.env` via flutter_dotenv and, in older
#   configurations, bundled it as an application asset. Anything bundled
#   into a distributed app can be extracted, so treat every value below as
#   CLIENT configuration, not as a protected secret.
# - RAZORPAY_KEY_ID is the public client identifier used to open the
#   Razorpay checkout sheet. The RAZORPAY_KEY_SECRET must NEVER be placed
#   in Flutter source — it lives only in the server-side Cloud Functions
#   configuration (functions/.env -> Firebase parameter).
# - GEMINI_API_KEY is used by the server-side support-AI backend. The
#   Flutter app does not read it directly. Keep it out of the client.
# ============================================================

# Runtime environment (development | production)
ENVIRONMENT=development

# Razorpay public client key (test keys start with rzp_test_)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Google Gemini API key (backend-only; not used by the Flutter app)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
